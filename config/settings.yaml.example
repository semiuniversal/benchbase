# Copy to settings.yaml and edit for your environment:
#   cp config/settings.yaml.example config/settings.yaml
#
# Docker: mount this directory to /app/config. Set BENCHBASE_DB_URL in compose
# overrides database_url below — leave database_url as-is for local CLI dev.

# LLManifold on revenant: plain HTTP on :20004 (not https). Trailing /v1 is optional.
litellm_base_url: http://revenant.jackalope-bicolor.ts.net:20004
# From Docker on revenant, prefer this Tailscale URL — not localhost or host.docker.internal.
# Optional — only when the proxy requires Bearer auth (legacy LiteLLM setups).
litellm_api_key: ""
database_url: sqlite+aiosqlite:///benchbase.db
theme: light
default_models: []
benchmark_suites:
  - speed
  - coding
  - tool_use
  - reasoning
litebench_timeout_seconds: 1200
batch_sample_limit: 10
routine_sample_limit: 50
# How many models may run tier axes at once (one axis per model). 3 suits two Sparks + hosted.
batch_model_concurrency: 3
# Speed-index baseline seat on Compare (100% = DeepSeek V4 Flash 0731 on OpenRouter work clock). Empty = raw s/correct.
work_clock_reference_model: null
